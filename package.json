{
  "name": "xplane-rocket-odyssey",
  "version": "0.1.0",
  "private": true,
  "description": "Rocket Odyssey: an educational space mission design game.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently --kill-others --names web,server --prefix-colors cyan,yellow \"npm run dev --workspace @rocket-odyssey/web\" \"npm run dev --workspace @rocket-odyssey/server\"",
    "build": "npm run build --workspace @rocket-odyssey/web && npm run build --workspace @rocket-odyssey/server",
    "start": "npm run start --workspace @rocket-odyssey/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
